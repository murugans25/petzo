NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy public key is accepted by existing Supabase projects if no publishable key exists.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only elevated key. Never expose it in browser code or commit it.
SUPABASE_SECRET_KEY=
# Legacy server-only elevated key; keep empty unless the project only exposes this key.
SUPABASE_SERVICE_ROLE_KEY=
# Use Supabase Storage by default. Set STORAGE_PROVIDER=r2 after Cloudflare R2
# credentials, buckets, public URL, and CORS are configured.
STORAGE_PROVIDER=supabase
DATABASE_PROVIDER=supabase
# Neon pooled endpoint for Vercel/runtime. Keep both values server-only.
DATABASE_URL=
# Neon direct endpoint for Prisma migrations.
DIRECT_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=petzo-media
# Only needed for seller documents previously uploaded to the private R2 bucket.
R2_PRIVATE_BUCKET=petzo-private-documents
R2_PUBLIC_URL=
# Stable server-only secret for seller documents. Defaults to ADMIN_SESSION_SECRET.
# Keep the effective secret consistent across deployments to retain document access.
SELLER_DOCUMENT_ENCRYPTION_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=

# Local admin development mode (not for public deployment)
LOCAL_ADMIN_ENABLED=false
ADMIN_EMAIL=admin@petzo.local
# Generated by npm run setup:local. Never expose in client code.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Razorpay webhook URL: https://www.petzo.org/api/payments/webhook (payment.captured, order.paid)
