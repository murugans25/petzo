{
  "name": "petmate",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:supabase-to-neon": "node scripts/migrate-supabase-to-neon.mjs --apply",
    "start": "next start --hostname 0.0.0.0",
    "setup:local": "node scripts/setup-local.mjs",
    "migrate:supabase": "node --env-file=.env.local scripts/migrate-sqlite-to-supabase.mjs",
    "test:admin": "node scripts/admin-smoke.mjs",
    "test:browser": "node scripts/admin-browser.mjs",
    "test:admin-controls": "node scripts/admin-controls.mjs",
    "test:discovery": "node --experimental-strip-types scripts/discovery-unit.mjs",
    "test:profile-discovery": "node scripts/profile-discovery-browser.mjs",
    "test:favourites": "node scripts/favourites-browser.mjs",
    "build:preview": "node scripts/build-netlify-preview.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@prisma/adapter-neon": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/supabase-js": "^2.49.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^18.0.10",
    "prisma": "^7.10.1",
    "typescript": "^5.7.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
